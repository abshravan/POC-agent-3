# Speaker Identification System Configuration
# Copy this file to .env and adjust values as needed

# ============ Application ============
APP_NAME="Speaker Identification System"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development  # development, staging, production

# ============ API Settings ============
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
API_WORKERS=1

# ============ Audio Processing ============
TARGET_SAMPLE_RATE=16000
MIN_AUDIO_DURATION=1.0
MAX_AUDIO_DURATION=30.0
AUDIO_CHUNK_DURATION=10.0
AUDIO_CHUNK_OVERLAP=0.5

# ============ Voice Activity Detection ============
VAD_AGGRESSIVENESS=2
VAD_FRAME_DURATION_MS=30

# ============ Audio Quality Thresholds ============
MIN_SNR_DB=10.0
MIN_RMS_ENERGY=0.005

# ============ Embedding Model ============
EMBEDDING_MODEL_NAME=nvidia/speakerverification_en_titanet_large
EMBEDDING_DIMENSION=192
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_TTL=3600

# ============ Device Settings ============
DEVICE=cpu  # cpu, cuda, cuda:0
USE_GPU=false

# ============ Vector Database (Qdrant) ============
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=speaker_embeddings
QDRANT_PATH=./data/qdrant  # For embedded mode

# ============ Metadata Database ============
DATABASE_URL=sqlite+aiosqlite:///./data/sqlite/speakers.db

# ============ Identification Thresholds ============
IDENTIFICATION_THRESHOLD=0.55
ENROLLMENT_VERIFICATION_THRESHOLD=0.70
HIGH_CONFIDENCE_THRESHOLD=0.75
SIMILARITY_SEARCH_TOP_K=10

# ============ Enrollment Settings ============
MIN_ENROLLMENT_SAMPLES=3
MAX_ENROLLMENT_SAMPLES=10
ENROLLMENT_CONSISTENCY_THRESHOLD=0.80
SIMILAR_SPEAKER_WARNING_THRESHOLD=0.70

# ============ Monitoring ============
ENABLE_METRICS=true
METRICS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=console  # console, json

# ============ Security ============
SECRET_KEY=change-me-in-production-please
ENCRYPT_EMBEDDINGS=false
# ENCRYPTION_KEY=  # Required if ENCRYPT_EMBEDDINGS=true

# ============ Rate Limiting ============
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============ Redis (Optional) ============
# REDIS_URL=redis://localhost:6379/0
